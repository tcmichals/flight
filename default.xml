<?xml version="1.0" encoding="UTF-8"?>
<!-- @impl [SPEC-FLIGHT-02] docs/SPECIFICATION.md: the revisions below are the tested set. -->
<!-- @impl [SPEC-FLIGHT-04] docs/SPECIFICATION.md: projects are tied together only by this file. -->
<!-- @impl [SPEC-FLIGHT-08] docs/SPECIFICATION.md: abstractx-fpga is the single source for FPGA RTL; small boards carry no PIO tile. -->
<manifest>
  <remote name="github-ssh" fetch="git@github.com:tcmichals/"/>
  <remote name="github" fetch="https://github.com/tcmichals/"/>
  <remote name="buildroot-org" fetch="https://gitlab.com/buildroot.org/"/>

  <default remote="github" sync-j="6"/>

  <!-- This repo. It follows main: it holds the pins, so it cannot pin itself. -->
  <project name="flight" path="flight" remote="github-ssh" revision="main">
    <linkfile src="CMakeLists.txt" dest="CMakeLists.txt"/>
    <linkfile src="CMakePresets.json" dest="CMakePresets.json"/>
  </project>

  <!-- Flight: the default checkout. -->
  <project name="inav" path="inav" upstream="flight-abstractx-path"
           revision="a8985f74dc4ed66091db127dfeea9fdc85558be2"/>
  <!-- No sync-s: it pulls MicroPython's submodules recursively (1.8 GB). CMakeLists.txt fetches what a build needs. -->
  <project name="AbstractX" path="AbstractX" upstream="main"
           revision="c1c63a31a925285b4a49532663d599ba8ae3b45c"/>
  <project name="abstractx-fpga" path="abstractx-fpga" upstream="main"
           revision="6dad65d19d86be7b3bebf32b80d3060dc734741b"/>
  <!-- AbstractX rtl/pio commit with isolation fixes -->
  <project name="pio2" path="pio2" upstream="flight-integration"
           revision="b22af6e54c63e1a086411a19d9df3c243d62e0f4"/>

  <!-- Linux: only with repo init -g default,linux. cubie-a5e is the Buildroot out-of-tree (BR2_EXTERNAL). -->
  <project name="buildroot" path="buildroot" remote="buildroot-org" upstream="master"
           groups="notdefault,linux"
           revision="9e9110bf23a86d1e312e23fc19921cd911f53861"/>
  <project name="linux-cubie" path="linux-cubie" upstream="cubie-linux-7.1" clone-depth="1"
           groups="notdefault,linux"
           revision="9a5f36c0628d045be3fd67b5e1541b88c1335fda"/>
  <project name="cubie-a5e" path="cubie-a5e" upstream="main"
           groups="notdefault,linux"
           revision="e67d77b39936f9668639b05c25143f80ab27a68a"/>
</manifest>
